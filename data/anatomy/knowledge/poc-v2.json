          "suprascapular-nerve"
        ],
        "review": {
          "status": "candidate"
        }
      },
      "details": {
        "roots": {
          "text": "Primarily C5–C6 from the upper trunk of the brachial plexus.",
          "sourceIds": [
            "suprascapular-nerve"
          ],
          "review": {
            "status": "candidate"
          }
        },
        "course": {
          "text": "Passes via the suprascapular notch into the supraspinous fossa and continues toward infraspinatus.",
          "sourceIds": [
            "suprascapular-nerve"
          ],
          "review": {
            "status": "candidate"
          }
        },
        "motorDistribution": {
          "text": "Supraspinatus and infraspinatus muscles.",
          "sourceIds": [
            "suprascapular-nerve"
          ],
          "review": {
            "status": "candidate"
          }
        },
        "sensoryDistribution": {
          "text": "Articular branches contribute to shoulder joint sensation.",
          "sourceIds": [
            "suprascapular-nerve"
          ],
          "review": {
            "status": "candidate"
          }
        }
      },
