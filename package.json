    "test:presentation": "node --experimental-strip-types --test scripts/presentation.test.mjs",
    "test:presentation:browser": "node --experimental-strip-types scripts/presentation-browser-smoke.mjs",
    "test:explosion": "node --experimental-strip-types --test scripts/explosion-layout.test.mjs",
    "test:explosion:browser": "node --experimental-strip-types scripts/explosion-browser-smoke.mjs",
    "test:isolation-workspace": "node --experimental-strip-types --test scripts/isolation-workspace.test.mjs",
